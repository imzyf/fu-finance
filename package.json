{
  "name": "fu-finance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "tsc -b config/tsconfig.json && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "test": "vitest --config config/vite.config.ts",
    "typecheck": "tsc -b config/tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config config/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config config/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config config/drizzle.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "antd": "^6.6.4",
    "drizzle-orm": "^0.45.2",
    "highcharts": "^13.0.2",
    "highcharts-react-official": "^3.2.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.9",
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "4.136.3"
  }
}
